TIDINGS_DATA_DIR=/var/lib/tidings
TIDINGS_ADDR=127.0.0.1:8085
# Set these before exposing the service through your HTTPS reverse proxy:
# TIDINGS_BASE_URL=https://tidings.example.org
# TIDINGS_SECURE_COOKIES=true
# TIDINGS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
TIDINGS_BACKUP_INTERVAL=24h
TIDINGS_BACKUP_KEEP=7
