# systemd configuration: /etc/tidings/tidings.env
# Use KEY="value" for every setting; no export statements are needed.
# OpenRC uses /etc/conf.d/tidings instead.

TIDINGS_DATA_DIR="/var/lib/tidings"
TIDINGS_ADDR="127.0.0.1:8085"
# Set these before exposing the service through your HTTPS reverse proxy:
# TIDINGS_BASE_URL="https://tidings.example.org"
# TIDINGS_SECURE_COOKIES="true"
# TIDINGS_TRUSTED_PROXIES="127.0.0.1/32,::1/128"
TIDINGS_BACKUP_INTERVAL="24h"
TIDINGS_BACKUP_KEEP="7"

# Optional suite links and explicitly linked community sign-in; see docs/suite.md.
# TIDINGS_APPS=""
# TIDINGS_SHARED_ISSUER=""
# TIDINGS_SHARED_CLIENT_ID=""
# TIDINGS_SHARED_CLIENT_SECRET=""
