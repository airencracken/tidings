#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
case "$1" in
	configure)
		if ! getent group tidings >/dev/null; then
			addgroup --system tidings || exit 1
		fi
		if ! getent passwd tidings >/dev/null; then
			adduser --system --ingroup tidings --home /var/lib/tidings \
				--no-create-home --shell /usr/sbin/nologin tidings || exit 1
		fi
		if [ "$(id -u tidings)" = 0 ] || [ "$(getent group tidings | cut -d: -f3)" = 0 ]; then
			echo 'Refusing to run Tidings with a root service account or group.' >&2
			exit 1
		fi
		install -d -o tidings -g tidings -m 0700 /var/lib/tidings || exit 1
		if [ -d /run/systemd/system ]; then
			systemctl daemon-reload || exit 1
			# Restart an already-running instance on upgrade; never start or enable
			# a new installation before the operator has configured it.
			deb-systemd-invoke try-restart tidings.service || exit 1
		fi
		;;
esac
exit 0
